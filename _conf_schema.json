{
    "enable_platforms": {
        "description": "启用的平台",
        "hint": "勾选要启用解析的平台。",
        "type": "list",
        "options": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ],
        "default": [
            "B站",
            "抖音",
            "小红书",
            "微博",
            "X"
        ]
    },
    "bili_settings": {
        "description": "B站设置",
        "type": "object",
        "items": {
            "video_quality": {
                "description": "B站视频下载画质",
                "type": "string",
                "hint": "选择下载视频的画质。",
                "default": "1080P高帧率",
                "options": [
                    "原画 (最高画质)",
                    "8K",
                    "4K",
                    "1080P高帧率",
                    "1080P",
                    "720P",
                    "最低"
                ]
            },
            "allow_quality_fallback": {
                "description": "超限时自动降画质",
                "type": "bool",
                "hint": "当视频大小超过限制时，自动尝试更低画质下载。",
                "default": true
            },
            "merge_send": {
                "description": "B站合并发送",
                "type": "bool",
                "hint": "开启后将 B 站视频信息和视频合并转发发送（多P默认合并）。不开启只发送单独视频; 视频合并转发总是会有点bug, 推荐单独发送",
                "default": false
            },
            "summary_mode": {
                "description": "B站摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。文字摘要只替换卡片节点，不改变媒体发送方式。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "enable_multi_page": {
                "description": "B站多P视频处理",
                "type": "bool",
                "hint": "开启后，遇到多P视频将按配置下载多个分P。",
                "default": true
            },
            "multi_page_max": {
                "description": "B站多P最多下载数量",
                "type": "int",
                "hint": "多P视频最多下载的分P数量。",
                "default": 3,
                "min": 1,
                "max": 20
            },
            "max_duration_seconds": {
                "description": "B站最大视频时长(秒)",
                "type": "int",
                "hint": "视频时长超过该值时直接提示并忽略后续解析。设为 0 表示不限制。",
                "default": 300,
                "min": 0,
                "max": 86400
            },
            "cookies": {
                "description": "B站Cookies",
                "type": "string",
                "hint": "粘贴导出的 Cookie 字符串（可选）。填写后可下载更高画质。留空则使用游客模式。",
                "default": ""
            }
        }
    },
    "douyin_settings": {
        "description": "抖音设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "抖音最多发送媒体数",
                "type": "int",
                "hint": "抖音图集/动图最多发送的数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "抖音视频合并发送",
                "type": "bool",
                "hint": "仅对视频生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文笔记始终使用合并转发。",
                "default": false
            },
            "summary_mode": {
                "description": "抖音摘要模式",
                "type": "string",
                "hint": "决定合并发送时摘要节点使用纯文字还是渲染卡片。文字摘要只替换卡片节点，不改变媒体发送方式。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            }
        }
    },
    "weibo_settings": {
        "description": "微博设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "微博最多发送媒体数",
                "type": "int",
                "hint": "微博图文最多发送的图片数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "微博视频合并发送",
                "type": "bool",
                "hint": "仅对视频微博生效。开启时发送文本摘要+视频的合并转发；关闭时只发送单独视频。图文微博始终使用合并转发。",
                "default": false
            },
            "download_original": {
                "description": "下载微博原图",
                "type": "bool",
                "hint": "开启后优先下载微博原图/大图；关闭则优先下载普通大图，但仍会自动回退到可用图片。",
                "default": true
            },
            "cookies": {
                "description": "微博Cookies",
                "type": "string",
                "hint": "可选。粘贴浏览器导出的 Cookie 字符串（k=v;...）。留空时插件会先尝试生成访客 Cookie 解析公开微博。",
                "default": ""
            }
        }
    },
    "twitter_settings": {
        "description": "X 设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "X 最多发送媒体数",
                "type": "int",
                "hint": "单条推文最多发送的图片和视频数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "X 单视频合并发送",
                "type": "bool",
                "hint": "仅对单视频推文生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文、多视频、混合媒体推文始终合并转发。",
                "default": false
            }
        }
    },
    "media_randomizer": {
        "description": "X 图片随机预处理",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用X图片随机预处理",
                "type": "bool",
                "hint": "仅作用于 X 下载的图片：发送前对每张图做轻微随机改动并重新编码，降低跨群转发图片的一致性。动图（GIF/动画WebP/APNG）始终使用原文件。",
                "default": true
            },
            "weight_reencode": {
                "description": "重编码权重",
                "type": "int",
                "hint": "仅重新编码（分辨率与格式不变）的相对权重，0 为停用。各策略权重为相对值，不要求合计为 100。",
                "default": 30,
                "min": 0,
                "max": 1000
            },
            "weight_border": {
                "description": "加边框权重",
                "type": "int",
                "hint": "四周增加 1~3px 黑/白边框的相对权重，0 为停用。",
                "default": 20,
                "min": 0,
                "max": 1000
            },
            "weight_crop": {
                "description": "裁边权重",
                "type": "int",
                "hint": "随机选择一条边裁掉 1~2px 的相对权重，0 为停用。",
                "default": 15,
                "min": 0,
                "max": 1000
            },
            "weight_canvas": {
                "description": "扩展画布权重",
                "type": "int",
                "hint": "宽、高各增加 1~6px 并随机放置原图的相对权重，0 为停用。",
                "default": 15,
                "min": 0,
                "max": 1000
            },
            "weight_edge_noise": {
                "description": "边缘涂色噪声权重",
                "type": "int",
                "hint": "在外侧边缘区域随机涂 2~20 个黑/白像素的相对权重，0 为停用。",
                "default": 10,
                "min": 0,
                "max": 1000
            },
            "weight_pixel_noise": {
                "description": "像素微调噪声权重",
                "type": "int",
                "hint": "在外侧边缘区域随机微调 5~30 个像素（各 RGB 通道独立 ±1~3）的相对权重，0 为停用。",
                "default": 10,
                "min": 0,
                "max": 1000
            },
            "weight_animation_skip": {
                "description": "动图处理权重",
                "type": "int",
                "hint": "动图处理策略权重。当前仅支持跳过（使用原文件）。",
                "default": 100,
                "min": 0,
                "max": 1000
            },
            "border_color": {
                "description": "边框颜色",
                "type": "string",
                "hint": "边框颜色的选取方式。",
                "default": "随机黑白",
                "options": [
                    "随机黑白",
                    "黑",
                    "白"
                ]
            },
            "canvas_background": {
                "description": "画布背景颜色",
                "type": "string",
                "hint": "扩展画布新增区域的背景色（不透明）。",
                "default": "随机黑白",
                "options": [
                    "随机黑白",
                    "黑",
                    "白"
                ]
            },
            "noise_color": {
                "description": "噪声像素颜色",
                "type": "string",
                "hint": "边缘噪声像素的颜色，逐像素随机抽取。",
                "default": "随机黑白",
                "options": [
                    "随机黑白",
                    "黑",
                    "白"
                ]
            },
            "jpeg_quality": {
                "description": "JPEG编码质量",
                "type": "int",
                "hint": "JPEG 重新编码质量（1~100），使用 4:4:4 采样。",
                "default": 95,
                "min": 1,
                "max": 100
            },
            "webp_quality": {
                "description": "WebP编码质量",
                "type": "int",
                "hint": "有损 WebP 重新编码质量（1~100）；无损 WebP 保持无损编码。",
                "default": 95,
                "min": 1,
                "max": 100
            },
            "png_compress_level": {
                "description": "PNG压缩级别",
                "type": "int",
                "hint": "PNG 重新编码压缩级别（0~9）。",
                "default": 6,
                "min": 0,
                "max": 9
            },
            "max_modified_ratio": {
                "description": "噪声像素比例上限",
                "type": "float",
                "hint": "噪声策略修改的像素数不超过总像素的该比例（(0, 1]，默认 0.1%），小图按上限自动缩减；超出范围的值会停用噪声策略。",
                "default": 0.001,
                "min": 0.0001,
                "max": 1
            },
            "border_min_px": {
                "description": "边框最小宽度px",
                "type": "int",
                "hint": "边框厚度下限。",
                "default": 1,
                "min": 1,
                "max": 32
            },
            "border_max_px": {
                "description": "边框最大宽度px",
                "type": "int",
                "hint": "边框厚度上限。",
                "default": 3,
                "min": 1,
                "max": 32
            },
            "crop_min_px": {
                "description": "裁边最小px",
                "type": "int",
                "hint": "单边裁切宽度下限。",
                "default": 1,
                "min": 1,
                "max": 32
            },
            "crop_max_px": {
                "description": "裁边最大px",
                "type": "int",
                "hint": "单边裁切宽度上限。",
                "default": 2,
                "min": 1,
                "max": 32
            },
            "canvas_min_px": {
                "description": "画布扩展最小px",
                "type": "int",
                "hint": "宽/高扩展像素下限。",
                "default": 1,
                "min": 1,
                "max": 64
            },
            "canvas_max_px": {
                "description": "画布扩展最大px",
                "type": "int",
                "hint": "宽/高扩展像素上限。",
                "default": 6,
                "min": 1,
                "max": 64
            },
            "noise_region_px": {
                "description": "噪声区域宽度px",
                "type": "int",
                "hint": "边缘噪声作用的外侧区域厚度。",
                "default": 2,
                "min": 1,
                "max": 32
            },
            "edge_noise_min_count": {
                "description": "涂色噪声最少像素",
                "type": "int",
                "hint": "单张图涂黑/白的最少像素数（实际数量受比例上限约束）。",
                "default": 2,
                "min": 1,
                "max": 1000
            },
            "edge_noise_max_count": {
                "description": "涂色噪声最多像素",
                "type": "int",
                "hint": "单张图涂黑/白的最多像素数（实际数量受比例上限约束）。",
                "default": 20,
                "min": 1,
                "max": 1000
            },
            "pixel_noise_min_count": {
                "description": "微调噪声最少像素",
                "type": "int",
                "hint": "单张图微调的最少像素数（实际数量受比例上限约束）。",
                "default": 5,
                "min": 1,
                "max": 1000
            },
            "pixel_noise_max_count": {
                "description": "微调噪声最多像素",
                "type": "int",
                "hint": "单张图微调的最多像素数（实际数量受比例上限约束）。",
                "default": 30,
                "min": 1,
                "max": 1000
            },
            "pixel_noise_delta_min": {
                "description": "微调幅度下限",
                "type": "int",
                "hint": "各 RGB 通道的最小调整量。",
                "default": 1,
                "min": 1,
                "max": 128
            },
            "pixel_noise_delta_max": {
                "description": "微调幅度上限",
                "type": "int",
                "hint": "各 RGB 通道的最大调整量。",
                "default": 3,
                "min": 1,
                "max": 128
            },
            "cleanup_after_send": {
                "description": "发送后立即清理副本",
                "type": "bool",
                "hint": "等待消息发送完成后删除本次生成的副本；关闭后由周期清理按保留时长兜底。",
                "default": true
            },
            "cleanup_interval_minutes": {
                "description": "目录清理周期(分钟)",
                "type": "int",
                "hint": "插件启动时清理一次预处理目录，之后按该周期清理。",
                "default": 60,
                "min": 5,
                "max": 1440
            },
            "cleanup_retention_hours": {
                "description": "副本保留时长(小时)",
                "type": "int",
                "hint": "预处理副本超过该时长后会在清理时删除（正在处理的事务文件除外）。",
                "default": 24,
                "min": 1,
                "max": 720
            }
        }
    },
    "xhs_settings": {
        "description": "小红书设置",
        "type": "object",
        "items": {
            "max_media": {
                "description": "小红书最多发送媒体数",
                "type": "int",
                "hint": "小红书图集最多发送的数量。",
                "default": 99,
                "min": 1,
                "max": 99
            },
            "merge_send": {
                "description": "小红书视频合并发送",
                "type": "bool",
                "hint": "仅对视频笔记生效。开启时发送摘要+视频的合并转发；关闭时只发送单独视频。图文笔记始终使用合并转发。",
                "default": false
            },
            "summary_mode": {
                "description": "小红书摘要模式",
                "type": "string",
                "hint": "决定摘要节点使用纯文字还是渲染卡片。文字摘要只替换卡片节点，不改变图文合并转发、逐条发送或视频发送方式。",
                "default": "文字摘要",
                "options": [
                    "文字摘要",
                    "渲染卡片"
                ]
            },
            "download_original": {
                "description": "下载小红书原图",
                "type": "bool",
                "hint": "开启后通过 CDN 直接下载原始高质量图片（通常为 JPEG），关闭则回退到普通解析。",
                "default": true
            },
            "prefer_ci_png": {
                "description": "小红书优先CI-PNG转码",
                "type": "bool",
                "hint": "开启后优先通过腾讯云CI将图片转码为PNG格式(只是 JPEG 转码为 PNG, 不会有画质的提升, 并且部分图片可能转码失败回退到CDN原图)。",
                "default": true
            },
            "auto_unmerge_threshold_mb": {
                "description": "小红书自动解合阈值(MB)",
                "type": "int",
                "hint": "当下载的图片总大小超过此值时，改为逐条发送，防止客户端崩溃。设为0禁用。",
                "default": 50
            },
            "qq_image_size_limit_mb": {
                "description": "QQ图片转文件阈值(MB)",
                "type": "int",
                "hint": "当单张图片超过此大小时，改为文件组件发送以绕过 QQ 图片体积限制。设为0禁用转换。",
                "default": 30,
                "min": 0,
                "max": 200
            },
            "concurrent_download": {
                "description": "小红书图片并发下载",
                "type": "bool",
                "hint": "开启后同时下载多张图片，大幅提升图集解析速度；关闭则逐张串行下载。如遇下载异常可尝试关闭。",
                "default": true
            }
        }
    },
    "general_settings": {
        "description": "通用设置",
        "type": "object",
        "items": {
            "retry_count": {
                "description": "解析失败重试次数",
                "type": "int",
                "hint": "各平台解析失败时的重试次数，设为0禁用重试",
                "default": 3,
                "min": 0,
                "max": 10
            },
            "reaction_emoji_enabled": {
                "description": "识别后表情回应",
                "type": "bool",
                "hint": "识别到链接/卡片后点一个表情，提示开始处理。",
                "default": true
            },
            "reaction_emoji_list": {
                "description": "回应表情ID列表(0~5个)",
                "type": "list",
                "hint": "QQ emoji_id,空列表=不回应,最多5个。常用:棒棒糖=147 OK=124 赞=76 爱心=66。完整列表: https://bot.q.qq.com/wiki/develop/api-v2/openapi/emoji/model.html",
                "default": [
                    127827
                ]
            },
            "reaction_emoji_strategy": {
                "description": "回应策略",
                "type": "string",
                "hint": "随机:每次从列表抽1个。顺序循环:按列表依次全部回应,每个间隔0.5s(同一消息多表情)。",
                "default": "随机",
                "options": [
                    "随机",
                    "顺序循环"
                ]
            },
            "auto_install_fonts": {
                "description": "自动安装插件字体",
                "type": "bool",
                "hint": "默认关闭。开启后在插件重载/加载时自动下载中文主字体和 Emoji 字体到插件 data/fonts 目录，并优先用于卡片渲染。会依次尝试多个下载源；若全部失败，可手动将字体文件放到 data/fonts。",
                "default": false
            },
            "custom_font_path": {
                "description": "自定义主字体路径",
                "type": "string",
                "hint": "可选。填写本机或容器内可访问的字体文件绝对路径；配置后优先级高于插件自动安装字体和系统字体。",
                "default": ""
            },
            "custom_emoji_font_path": {
                "description": "自定义 Emoji 字体路径",
                "type": "string",
                "hint": "可选。填写本机或容器内可访问的 Emoji 字体文件绝对路径；配置后优先级高于插件自动安装字体和系统 Emoji 字体。",
                "default": ""
            },
            "max_video_size_mb": {
                "description": "最大视频大小 (MB)",
                "type": "int",
                "hint": "超过此大小的视频将不会下载。设置为 0 表示无限制。",
                "default": 200,
                "min": 0,
                "max": 1000
            },
            "merge_send_as_sender": {
                "description": "合并转发显示为发送者",
                "type": "bool",
                "hint": "开启后合并转发的发送人显示为发送链接的用户；关闭则显示为 Bot。",
                "default": false
            },
            "error_notify_mode": {
                "description": "错误通知模式",
                "type": "string",
                "hint": "控制解析/下载失败时 Bot 是否在群内发送错误消息。静默：仅记录日志；脱敏：发送通用错误提示（不含异常详情）；报错：发送完整错误信息。",
                "default": "静默",
                "options": [
                    "静默",
                    "脱敏",
                    "报错"
                ]
            }
        }
    },
    "group_filter": {
        "description": "群过滤(黑/白名单)",
